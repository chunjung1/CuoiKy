@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 py-5">
                <div class="card-body">
                    <i class="fas fa-exclamation-triangle fa-5x text-warning mb-4"></i>
                    <h2 class="fw-bold mb-3">Từ chối truy cập</h2>
                    <p class="text-muted mb-4">Bạn không có quyền truy cập vào trang này. Chỉ tài khoản Quản trị viên mới có quyền này.</p>
                    <div class="d-grid gap-2 col-6 mx-auto">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Quay lại trang chủ</a>
                        <a asp-action="Logout" class="btn btn-outline-secondary">Đăng xuất</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
