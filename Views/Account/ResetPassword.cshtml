@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <h2 class="text-center fw-bold mb-4">Đặt lại mật khẩu</h2>
                    <p class="text-muted text-center mb-4">Mã khôi phục đã được gửi đến email của bạn. Vui lòng kiểm tra và nhập mã bên dưới.</p>
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" name="email" value="@ViewData["Email"]" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã khôi phục (Token)</label>
                            <input type="text" name="token" class="form-control text-center fs-4 fw-bold" placeholder="Nhập mã 6 chữ số" required />
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Mật khẩu mới</label>
                            <input type="password" name="newPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Xác nhận thay đổi</button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-4">
                        <p class="small text-muted mb-1">Không nhận được mã?</p>
                        <a asp-action="ForgotPassword" class="text-decoration-none small">Gửi lại mã mới</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
