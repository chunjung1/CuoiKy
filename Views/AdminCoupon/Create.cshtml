@model CuoiKy.Models.Coupon
@{
    ViewData["Title"] = "Tạo mã giảm giá mới - TechStore";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-plus-circle me-2"></i> Tạo mã giảm giá mới
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-bold"></label>
                            <input asp-for="Code" class="form-control text-uppercase" placeholder="VD: SUMMERSALE" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiscountPercent" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="DiscountPercent" type="number" min="1" max="100" class="form-control" placeholder="Mức phần trăm" />
                                <span class="input-group-text bg-light fw-bold">%</span>
                            </div>
                            <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpiryDate" class="form-label fw-bold"></label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UsageLimit" class="form-label fw-bold"></label>
                            <input asp-for="UsageLimit" type="number" min="1" class="form-control" placeholder="VD: 100" />
                            <span asp-validation-for="UsageLimit" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="fas fa-save me-1"></i> Lưu mã giảm giá
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-1"></i> Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
