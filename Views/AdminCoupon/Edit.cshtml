@model CuoiKy.Models.Coupon
@{
    ViewData["Title"] = "Cập nhật mã giảm giá - TechStore";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-edit me-2"></i> Cập nhật mã giảm giá
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UsedCount" />

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-bold"></label>
                            <input asp-for="Code" class="form-control text-uppercase" placeholder="VD: SUMMERSALE" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiscountPercent" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="DiscountPercent" type="number" min="1" max="100" class="form-control" />
                                <span class="input-group-text bg-light fw-bold">%</span>
                            </div>
                            <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpiryDate" class="form-label fw-bold"></label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="form-control" 
                                   value="@Model.ExpiryDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UsageLimit" class="form-label fw-bold"></label>
                            <input asp-for="UsageLimit" type="number" min="1" class="form-control" />
                            <span asp-validation-for="UsageLimit" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 bg-light p-3 rounded">
                            <span class="fw-bold">Số lượt đã dùng:</span> @Model.UsedCount / @Model.UsageLimit lượt
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning px-4 shadow-sm fw-bold">
                                <i class="fas fa-save me-1"></i> Cập nhật ngay
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-1"></i> Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
