@model IEnumerable<CuoiKy.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-shopping-bag me-2"></i>Quản lý đơn hàng</h2>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Tùy chọn</th>
                            <th>PT Thanh toán</th>
                            <th>TT Thanh toán</th>
                            <th>TT Giao hàng</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.Id</td>
                                <td>
                                    <div class="fw-bold">@item.CustomerName</div>
                                    <small class="text-muted">@item.PhoneNumber</small>
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@item.TotalAmount.ToString("N0")₫</td>
                                <td>
                                    @if (item.GiftWrap)
                                    {
                                        <span class="badge bg-warning text-dark me-1">Gói quà</span>
                                    }
                                    @if (item.ExpressShipping)
                                    {
                                        <span class="badge bg-danger">Hỏa tốc</span>
                                    }
                                    @if (!item.GiftWrap && !item.ExpressShipping)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.PaymentMethod == PaymentMethod.BankTransfer)
                                    {
                                        <span class="badge bg-info text-white">Chuyển khoản</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">COD</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.PaymentStatus)
                                    {
                                        case PaymentStatus.Pending:
                                            <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                            break;
                                        case PaymentStatus.Paid:
                                            <span class="badge bg-success">Đã thanh toán</span>
                                            break;
                                        case PaymentStatus.Failed:
                                            <span class="badge bg-danger">Thất bại</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case OrderStatus.Pending:
                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            break;
                                        case OrderStatus.Paid:
                                            <span class="badge bg-primary">Đã xác nhận</span>
                                            break;
                                        case OrderStatus.Shipping:
                                            <span class="badge bg-info">Đang giao hàng</span>
                                            break;
                                        case OrderStatus.Completed:
                                            <span class="badge bg-success">Hoàn thành</span>
                                            break;
                                        case OrderStatus.Canceled:
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm rounded">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.PaymentStatus == PaymentStatus.Pending && item.PaymentMethod == PaymentMethod.BankTransfer)
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm" onclick="confirmPayment(@item.Id)" title="Xác nhận đã thu tiền">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmPayment(orderId) {
            if (!confirm('Xác nhận đã nhận được tiền chuyển khoản cho đơn hàng #' + orderId + '?')) {
                return;
            }

            const formData = new FormData();
            formData.append('id', orderId);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('/AdminOrder/ConfirmPayment', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xác nhận thanh toán.');
            });
        }
    </script>
}

@Html.AntiForgeryToken()
