@model CuoiKy.ViewModels.Cart
@{
    ViewData["Title"] = "Thanh toán";
    var selectedTotal = Model.Items.Where(i => i.IsSelected).Sum(i => i.Price * i.Quantity);
    var selectedTotalInvariant = selectedTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">Thanh toán đơn hàng</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }
    
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    Thông tin giao hàng
                </div>
                <div class="card-body">
                    <form asp-action="ProcessCheckout" method="post">
                        <input type="hidden" name="couponCode" id="appliedCouponCode" />
                        <div class="mb-3">
                            <label class="form-label">Họ và tên người nhận</label>
                            <input type="text" name="customerName" class="form-control" required value="@User.Identity?.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="tel" name="phoneNumber" class="form-control" 
                            required 
                            oninput="this.value = this.value.replace(/[^0-9]/g, '');" 
                            maxlength="10" 
                            pattern="^0[0-9]{9}$" 
                            title="Vui lòng nhập số điện thoại hợp lệ (10 chữ số, bắt đầu bằng số 0)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ giao hàng chi tiết</label>
                            <textarea name="shippingAddress" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phương thức thanh toán</label>
                            <select name="paymentMethod" class="form-select">
                                <option value="0">Thanh toán khi nhận hàng (COD)</option>
                                <option value="1">Chuyển khoản ngân hàng (Thủ công)</option>
                                <option value="2">Thanh toán trực tuyến qua VietQR (PayOS)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Đơn vị vận chuyển</label>
                            <select name="shippingPartner" class="form-select">
                                <option value="ShopeeExpress">Shopee Express (Nhanh)</option>
                                <option value="GHN">Giao Hàng Nhanh (GHN)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tuỳ chọn thêm</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="giftWrap" name="giftWrap" value="true" onchange="updateCheckoutTotal()">
                                <label class="form-check-label" for="giftWrap">Gói quà (+15.000₫)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="expressShipping" name="expressShipping" value="true" onchange="updateCheckoutTotal()">
                                <label class="form-check-label" for="expressShipping">Giao hỏa tốc (+25.000₫)</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Xác nhận đặt hàng</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    Đơn hàng của bạn
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Model.Items.Where(i => i.IsSelected))
                        {
                            <li class="list-group-item d-flex justify-content-between lh-sm px-0">
                                <div>
                                    <h6 class="my-0">@item.Name</h6>
                                    <small class="text-muted">Số lượng: @item.Quantity</small>
                                </div>
                                <span class="text-muted">@((item.Price * item.Quantity).ToString("N0"))₫</span>
                            </li>
                        }
                    </ul>
                    
                    <div class="mb-3 pt-3 border-top">
                        <label class="form-label small fw-bold">Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" id="couponCodeInput" class="form-control form-control-sm text-uppercase" placeholder="Nhập mã..." />
                            <button class="btn btn-outline-primary btn-sm" type="button" onclick="applyCouponCode()">Áp dụng</button>
                        </div>
                        <div id="couponStatusMessage" class="small mt-1 d-none"></div>
                    </div>
                    
                    <div class="d-flex justify-content-between text-success mb-2 d-none" id="discountRow">
                        <span>Giảm giá (<span id="discountPercentLabel">0</span>%)</span>
                        <span id="discountAmountLabel">-0₫</span>
                    </div>

                    <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3">
                        <span>Tổng cộng</span>
                        <span class="text-danger" id="checkoutGrandTotal" data-base-total="@selectedTotalInvariant">@selectedTotal.ToString("N0")₫</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let appliedDiscountPercent = 0;

    function applyCouponCode() {
        const input = document.getElementById('couponCodeInput');
        const msgEl = document.getElementById('couponStatusMessage');
        const code = (input.value || '').trim();

        if (!code) {
            msgEl.className = 'small mt-1 text-danger';
            msgEl.textContent = 'Vui lòng nhập mã giảm giá.';
            msgEl.classList.remove('d-none');
            return;
        }

        fetch('/Cart/ApplyCoupon?code=' + encodeURIComponent(code))
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    appliedDiscountPercent = data.discountPercent;
                    document.getElementById('appliedCouponCode').value = code;
                    
                    msgEl.className = 'small mt-1 text-success';
                    msgEl.textContent = `Áp dụng mã giảm giá thành công! Giảm ${data.discountPercent}%.`;
                    msgEl.classList.remove('d-none');
                    
                    // Show discount row
                    const discountRow = document.getElementById('discountRow');
                    discountRow.classList.remove('d-none');
                    document.getElementById('discountPercentLabel').textContent = data.discountPercent;
                    
                    updateCheckoutTotal();
                } else {
                    appliedDiscountPercent = 0;
                    document.getElementById('appliedCouponCode').value = '';
                    document.getElementById('discountRow').classList.add('d-none');
                    
                    msgEl.className = 'small mt-1 text-danger';
                    msgEl.textContent = data.message || 'Mã giảm giá không hợp lệ.';
                    msgEl.classList.remove('d-none');
                    
                    updateCheckoutTotal();
                }
            })
            .catch(err => {
                console.error(err);
                msgEl.className = 'small mt-1 text-danger';
                msgEl.textContent = 'Có lỗi xảy ra khi áp dụng mã giảm giá.';
                msgEl.classList.remove('d-none');
            });
    }

    function updateCheckoutTotal() {
        const totalEl = document.getElementById('checkoutGrandTotal');
        if (!totalEl) return;

        const baseTotal = parseFloat(totalEl.getAttribute('data-base-total') || '0');
        const giftWrap = document.getElementById('giftWrap')?.checked === true;
        const express = document.getElementById('expressShipping')?.checked === true;

        let total = baseTotal;
        const discountAmount = Math.round(baseTotal * (appliedDiscountPercent / 100));
        
        if (appliedDiscountPercent > 0) {
            document.getElementById('discountAmountLabel').textContent = '-' + discountAmount.toLocaleString('vi-VN') + '₫';
            total = total - discountAmount;
        }

        if (giftWrap) total += 15000;
        if (express) total += 25000;

        totalEl.textContent = total.toLocaleString('vi-VN') + '₫';
    }

    updateCheckoutTotal();
</script>
