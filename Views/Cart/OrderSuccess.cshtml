@model CuoiKy.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="fas fa-check-circle fa-5x text-success"></i>
    </div>
    <h2 class="fw-bold mb-3">Cảm ơn bạn đã đặt hàng!</h2>
    <p class="lead mb-4">Đơn hàng của bạn đã được tiếp nhận thành công.</p>

    @if (Model.PaymentMethod == PaymentMethod.BankTransfer)
    {
        <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px;">
            <div class="card-body p-4">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    Đơn hàng của bạn đang ở trạng thái <strong>Chờ thanh toán</strong>.
                </div>
                <p class="mb-4 text-muted">Vui lòng quét mã QR dưới đây để thực hiện chuyển khoản. Hệ thống sẽ xử lý đơn ngay khi nhận được tiền.</p>
                
                <!-- QR Code Placeholder -->
                <div class="bg-light p-3 rounded mb-4 d-inline-block">
                    <img src="@ViewBag.QrUrl" 
                         alt="QR Code Thanh Toán" class="img-fluid" style="max-width: 250px;" />
                </div>

                <div class="text-start small">
                    <p class="mb-1"><strong>Ngân hàng:</strong> MB Bank</p>
                    <p class="mb-1"><strong>Số tài khoản:</strong> 0911551669</p>
                    <p class="mb-1"><strong>Chủ tài khoản:</strong> CTY TECHSTORE</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success d-inline-block px-5 py-3">
            <i class="fas fa-shipping-fast me-2"></i>
            Đơn hàng sẽ được giao đến bạn trong thời gian sớm nhất. Thanh toán khi nhận hàng (COD).
        </div>
    }

    <div class="mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5">Quay lại trang chủ</a>
    </div>
</div>
