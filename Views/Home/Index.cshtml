@model CuoiKy.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "TechStore - Trang chủ";
}

<style>
    .hero-carousel .carousel-item {
        height: 450px;
        background-color: #f8f9fa;
    }
    .hero-carousel .carousel-item img {
        object-fit: cover;
        height: 100%;
    }
    .category-card {
        transition: transform 0.3s;
        cursor: pointer;
        border: none;
        background: #f1f1f1;
    }
    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .quick-categories-row > .col {
        flex: 0 0 20%;
        max-width: 20%;
        min-width: 180px;
    }
    @@media (max-width: 992px) {
        .quick-categories-row > .col {
            flex: 0 0 40%;
            max-width: 40%;
        }
    }
    .section-title {
        border-left: 5px solid #008BFF;
        padding-left: 15px;
        margin-bottom: 25px;
        font-weight: bold;
    }
    .promo-banner {
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 21 / 9;
        background: #f8f9fa;
    }
    .promo-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .product-img-container {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        background: #fff;
    }
    .product-img-container img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }
    /* Horizontal scroll for latest products */
    .latest-products-scroll {
        display: flex;
        overflow-x: auto;
        padding-bottom: 15px;
        gap: 20px;
        scrollbar-width: thin;
    }
    .latest-products-scroll::-webkit-scrollbar {
        height: 6px;
    }
    .latest-products-scroll::-webkit-scrollbar-thumb {
        background: #008BFF;
        border-radius: 10px;
    }
    .latest-products-scroll .product-item {
        flex: 0 0 250px;
    }
    .btn-view-all {
        border: 1px solid #008BFF;
        color: #008BFF;
        border-radius: 5px;
        padding: 5px 15px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s;
    }
    .btn-view-all:hover {
        background: #008BFF;
        color: white;
    }
</style>

<!-- Hero Section -->
<div id="heroCarousel" class="carousel slide hero-carousel mb-5" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/lib/img/Slide1.png" class="d-block w-100" alt="Slide 1">
        </div>
        <div class="carousel-item">
            <img src="~/lib/img/Slide2.jpg" class="d-block w-100" alt="Slide 2">
        </div>
        <div class="carousel-item">
            <img src="~/lib/img/Slide3.jpg" class="d-block w-100" alt="Slide 3">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<div class="container">
    <!-- Quick Categories -->
    <div class="row mb-5 g-3 flex-nowrap overflow-auto pb-2 quick-categories-row">
        @foreach (var c in Model.Categories)
        {
            var name = c.Name;
            var displayName = name switch
            {
                "Accessory" => "Phụ kiện",
                "Headphone" => "Headphones",
                _ => name
            };
            var icon = name switch
            {
                "Laptop" => "fa-laptop",
                "Phone" => "fa-mobile-alt",
                "Keyboard" => "fa-keyboard",
                "Mouse" => "fa-mouse",
                "Headphone" => "fa-headphones",
                "Accessory" => "fa-plug",
                _ => "fa-tags"
            };

            <div class="col">
                <a asp-controller="Product" asp-action="List" asp-route-category="@name" class="text-decoration-none">
                    <div class="card category-card text-center p-3 h-100">
                        <i class="fas @icon fa-2x text-primary mb-2"></i>
                        <span class="small fw-bold text-dark">@displayName</span>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Promo Section -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="promo-banner">
                <img src="~/lib/img/BannerHome1.png" class="img-fluid" alt="Promo 1">
            </div>
        </div>
        <div class="col-md-6">
            <div class="promo-banner">
                <img src="~/lib/img/BannerHome2.png" class="img-fluid" alt="Promo 2">
            </div>
        </div>
    </div>

    <!-- Featured Products Preview -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="section-title mb-0">Sản phẩm mới nhất</h3>
        <a asp-controller="Product" asp-action="List" class="btn-view-all">Xem tất cả <i class="fas fa-chevron-right ms-1"></i></a>
    </div>

    <div class="latest-products-scroll mb-5">
        @if (Model.Products != null && Model.Products.Any())
        {
            @foreach (var item in Model.Products.OrderByDescending(p => p.Id).Take(6))
            {
                <div class="product-item">
                    <div class="card h-100 border-0 shadow-sm product-card">
                        <div class="product-img-container">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name">
                            }
                            else
                            {
                                <img src="/lib/img/no-image.png" alt="No Image">
                            }
                        </div>
                        <div class="card-body">
                            <h6 class="card-title text-truncate" title="@item.Name">@item.Name</h6>
                            <p class="text-danger fw-bold mb-1">@item.Price.ToString("N0")₫</p>
                            <div class="d-grid gap-2 mt-3">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                @if (item.StockQuantity <= 0)
                                {
                                    <button type="button" class="btn btn-sm btn-secondary w-100" disabled>Hết hàng</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-primary w-100" onclick="addToCart(@item.Id)">Thêm vào giỏ hàng</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="w-100 text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">Chưa có sản phẩm nào được cập nhật.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Product" asp-action="Create" class="btn btn-primary">Thêm sản phẩm ngay</a>
                }
            </div>
        }
    </div>
</div>
