@model CuoiKy.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="MyOrders" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
        <h2 class="fw-bold mt-2">Chi tiết đơn hàng #@Model.Id</h2>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">Sản phẩm</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Sản phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end pe-3">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@(item.Product?.ImageUrl ?? "/lib/img/no-image.png")" class="rounded me-3" style="width: 52px; height: 52px; object-fit: contain; background: #f8f9fa;" alt="@item.Product?.Name" />
                                                <div class="fw-bold">@item.Product?.Name</div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0")₫</td>
                                        <td class="text-end fw-bold pe-3">@item.TotalPrice.ToString("N0")₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold py-3">Tổng cộng:</td>
                                    <td class="text-end fw-bold text-danger fs-5 py-3 pe-3">@Model.TotalAmount.ToString("N0")₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-bold py-3">Trạng thái</div>
                <div class="card-body">
                    <div class="mb-2 text-muted small">Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div>
                        @switch (Model.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                break;
                            case OrderStatus.Paid:
                                <span class="badge bg-primary">Đã thanh toán</span>
                                break;
                            case OrderStatus.Shipping:
                                <span class="badge bg-info">Đang giao hàng</span>
                                break;
                            case OrderStatus.Completed:
                                <span class="badge bg-success">Hoàn thành</span>
                                break;
                            case OrderStatus.Canceled:
                                <span class="badge bg-danger">Đã hủy</span>
                                break;
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">Thông tin giao hàng</div>
                <div class="card-body">
                    <div class="mb-2"><strong>Người nhận:</strong> @Model.CustomerName</div>
                    <div class="mb-2"><strong>SĐT:</strong> @Model.PhoneNumber</div>
                    <div class="mb-0"><strong>Địa chỉ:</strong> @Model.ShippingAddress</div>
                </div>
            </div>
        </div>
    </div>
</div>

