@model IEnumerable<CuoiKy.Models.Order>
@{
    ViewData["Title"] = "Đơn đã mua";
    var filter = ViewBag.FilterStatus as OrderStatus?;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-receipt me-2"></i>Đơn đã mua</h2>
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="status" class="form-select" style="min-width: 220px;">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending" selected="@(filter == OrderStatus.Pending)">Chờ thanh toán</option>
                <option value="Paid" selected="@(filter == OrderStatus.Paid)">Đã thanh toán</option>
                <option value="Shipping" selected="@(filter == OrderStatus.Shipping)">Đang giao hàng</option>
                <option value="Completed" selected="@(filter == OrderStatus.Completed)">Hoàn thành</option>
                <option value="Canceled" selected="@(filter == OrderStatus.Canceled)">Đã hủy</option>
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i>Lọc</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Chưa có đơn hàng nào.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var o in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold fs-5">Đơn hàng </div>
                                    <div class="text-muted small">Ngày đặt: @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-danger fs-5">@o.TotalAmount.ToString("N0")₫</div>
                                    <div class="mt-1">
                                        @switch (o.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                                break;
                                            case OrderStatus.Paid:
                                                <span class="badge bg-primary">Đã thanh toán</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="badge bg-info">Đang giao hàng</span>
                                                break;
                                            case OrderStatus.Completed:
                                                <span class="badge bg-success">Hoàn thành</span>
                                                break;
                                            case OrderStatus.Canceled:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                        }
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in o.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="@(item.Product?.ImageUrl ?? "/lib/img/no-image.png")" class="rounded me-3" style="width: 48px; height: 48px; object-fit: contain; background: #f8f9fa;" alt="@item.Product?.Name" />
                                                        <div class="fw-bold">@item.Product?.Name</div>
                                                    </div>
                                                </td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N0")₫</td>
                                                <td class="text-end fw-bold">@item.TotalPrice.ToString("N0")₫</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

