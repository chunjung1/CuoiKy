@model IEnumerable<CuoiKy.Models.Order>
@{
    ViewData["Title"] = "Đơn đã mua";
    var filter = ViewBag.FilterStatus as OrderStatus?;
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @Html.Raw(TempData["SuccessMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @Html.Raw(TempData["ErrorMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="fw-bold mb-0"><i class="fas fa-receipt me-2"></i>Đơn đã mua</h2>
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="status" class="form-select" style="min-width: 220px;">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending" selected="@(filter == OrderStatus.Pending)">Chờ xử lý</option>
                <option value="Paid" selected="@(filter == OrderStatus.Paid)">Đã xác nhận</option>
                <option value="Shipping" selected="@(filter == OrderStatus.Shipping)">Đang vận chuyển</option>
                <option value="Completed" selected="@(filter == OrderStatus.Completed)">Đã giao</option>
                <option value="Canceled" selected="@(filter == OrderStatus.Canceled)">Đã hủy</option>
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i>Lọc</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Chưa có đơn hàng nào.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var o in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold fs-5">Đơn hàng #@o.Id</div>
                                    <div class="text-muted small">Ngày đặt: @o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-danger fs-5">@o.TotalAmount.ToString("N0")₫</div>
                                    <div class="mt-1">
                                        @switch (o.PaymentStatus)
                                        {
                                            case PaymentStatus.Pending:
                                                <span class="badge bg-warning text-dark me-1">Chờ thanh toán</span>
                                                break;
                                            case PaymentStatus.Paid:
                                                <span class="badge bg-success me-1">Đã thanh toán</span>
                                                break;
                                            case PaymentStatus.Failed:
                                                <span class="badge bg-danger me-1">Thất bại</span>
                                                break;
                                        }
                                        
                                        @switch (o.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="badge bg-secondary">Chờ xử lý</span>
                                                break;
                                            case OrderStatus.Paid:
                                                <span class="badge bg-primary">Đã xác nhận</span>
                                                break;
                                            case OrderStatus.Shipping:
                                                <span class="badge bg-info">Đang vận chuyển</span>
                                                break;
                                            case OrderStatus.Completed:
                                                <span class="badge bg-success">Đã giao</span>
                                                break;
                                            case OrderStatus.Canceled:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                        }
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in o.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="@(item.Product?.ImageUrl ?? "/lib/img/no-image.png")" class="rounded me-3" style="width: 48px; height: 48px; object-fit: contain; background: #f8f9fa;" alt="@item.Product?.Name" />
                                                        <div>
                                                            <div class="fw-bold">@item.Product?.Name</div>
                                                            @if (o.Status == OrderStatus.Completed)
                                                            {
                                                                <a href="/Product/Details/@item.ProductId" class="btn btn-sm btn-outline-warning py-0 px-2 mt-1" style="font-size: 0.75rem;">
                                                                    <i class="fas fa-star me-1"></i>Đánh giá
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">@item.UnitPrice.ToString("N0")₫</td>
                                                <td class="text-end fw-bold">@item.TotalPrice.ToString("N0")₫</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-end mt-3 flex-wrap gap-2">
                                @if (o.Status == OrderStatus.Pending || o.Status == OrderStatus.Paid)
                                {
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal" data-order-id="@o.Id">
                                        <i class="fas fa-times me-1"></i>Hủy đơn hàng
                                    </button>
                                }
                                @if (o.Status == OrderStatus.Shipping)
                                {
                                    <form asp-controller="Order" asp-action="ConfirmReceived" asp-route-id="@o.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success" onclick="return confirm('Bạn xác nhận đã nhận được đơn hàng này?')">
                                            <i class="fas fa-check me-1"></i>Đã nhận được hàng
                                        </button>
                                    </form>
                                }
                                @if (o.Status == OrderStatus.Completed)
                                {
                                    <form asp-controller="Cart" asp-action="Reorder" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <button type="submit" class="btn btn-outline-success">
                                            <i class="fas fa-redo me-1"></i>Mua lại
                                        </button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Cancel Order Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelOrderModalLabel"><i class="fas fa-exclamation-triangle me-2"></i>Yêu cầu hủy đơn hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="cancelOrderId" value="" />
                <div class="modal-body">
                    <p class="text-muted">Vui lòng chọn lý do hủy đơn hàng:</p>
                    
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="cancelOption" id="opt1" value="Tôi muốn thay đổi địa chỉ nhận hàng" checked>
                        <label class="form-check-label" for="opt1">
                            Tôi muốn thay đổi địa chỉ nhận hàng
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="cancelOption" id="opt2" value="Tôi muốn đổi phương thức thanh toán">
                        <label class="form-check-label" for="opt2">
                            Tôi muốn đổi phương thức thanh toán
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="cancelOption" id="opt3" value="Tôi muốn thay đổi các sản phẩm trong đơn hàng">
                        <label class="form-check-label" for="opt3">
                            Tôi muốn thay đổi các sản phẩm trong đơn hàng
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="cancelOption" id="opt4" value="Tìm thấy giá rẻ hơn ở nơi khác">
                        <label class="form-check-label" for="opt4">
                            Tìm thấy giá rẻ hơn ở nơi khác
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="cancelOption" id="opt5" value="Tôi không muốn mua nữa">
                        <label class="form-check-label" for="opt5">
                            Tôi không muốn mua nữa
                        </label>
                    </div>
                    <div class="form-check mb-3">
                         <input class="form-check-input" type="radio" name="cancelOption" id="opt6" value="Lý do khác">
                         <label class="form-check-label" for="opt6">
                             Lý do khác (Vui lòng nhập lý do cụ thể bên dưới)
                         </label>
                    </div>
                    
                    <div class="mb-3" id="otherReasonWrapper" style="display: none;">
                        <textarea class="form-control" name="otherReason" id="otherReasonText" rows="3" placeholder="Nhập lý do hủy cụ thể của bạn tại đây..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cancelModal = document.getElementById('cancelOrderModal');
            if (cancelModal) {
                cancelModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const orderId = button.getAttribute('data-order-id');
                    const modalInput = cancelModal.querySelector('#cancelOrderId');
                    modalInput.value = orderId;
                    
                    // reset Form
                    document.getElementById('opt1').checked = true;
                    document.getElementById('otherReasonText').value = '';
                    document.getElementById('otherReasonWrapper').style.display = 'none';
                });
            }

            // Add event listeners to radio buttons to show/hide textarea
            const radioButtons = document.querySelectorAll('input[name="cancelOption"]');
            radioButtons.forEach(radio => {
                radio.addEventListener('change', function () {
                    const otherWrapper = document.getElementById('otherReasonWrapper');
                    if (this.value === 'Lý do khác') {
                        otherWrapper.style.display = 'block';
                        document.getElementById('otherReasonText').setAttribute('required', 'required');
                    } else {
                        otherWrapper.style.display = 'none';
                        document.getElementById('otherReasonText').removeAttribute('required');
                    }
                });
            });
        });
    </script>
}
