<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-custom {
            background-color: #008BFF;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: white !important;
        }
        .navbar-custom .nav-link:hover {
            opacity: 0.8;
        }
        .search-box {
            border-radius: 20px;
            border: none;
            padding: 5px 15px;
        }
        .search-suggest {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.12);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            z-index: 2000;
            overflow: hidden;
            display: none;
        }
        .search-suggest a {
            text-decoration: none;
            color: inherit;
        }
        .search-suggest-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
        }
        .search-suggest-item:hover {
            background: #f6f9ff;
        }
        .search-suggest-thumb {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            background: #f1f3f5;
            object-fit: contain;
        }
        .search-suggest-name {
            font-weight: 600;
            line-height: 1.2;
        }
        .search-suggest-sub {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-laptop-code me-2"></i>TechStore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="List">Sản phẩm</a>
                        </li>
                    </ul>
                    
                    <form class="d-flex flex-grow-1 mx-lg-4 my-2 my-lg-0" asp-controller="Product" asp-action="List" method="get" autocomplete="off">
                        <div class="position-relative w-100">
                            <div class="input-group w-100">
                                <input id="headerSearchInput" name="q" value="@Context.Request.Query["q"]" class="form-control search-box" type="search" placeholder="Bạn cần tìm gì?" aria-label="Search" style="border-radius: 20px; padding-right: 45px;">
                            <button class="btn btn-light ms-n5" type="submit" style="border-radius: 0 20px 20px 0; margin-left: -40px; z-index: 5;">
                                <i class="fas fa-search"></i>
                            </button>
                            </div>
                            <div id="headerSearchSuggest" class="search-suggest"></div>
                        </div>
                    </form>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Order" asp-action="MyOrders">
                                    <i class="fas fa-receipt"></i>
                                    <span class="d-none d-lg-inline ms-2"></span>
                                </a>
                            </li>
                        }
                        @if (!(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="#" onclick="openCartModal(event)">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span class="d-lg-none ms-2">Giỏ hàng</span>
                                </a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                                        <i class="fas fa-user-shield text-warning"></i>
                                        <span class="d-lg-none ms-2">Quản trị</span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="fas fa-id-card me-2"></i>Trang cá nhân</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-user"></i>
                                    <span class="d-lg-none ms-2">Đăng nhập</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-4 pb-2 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="fw-bold text-primary">TechStore</h5>
                    <p class="small">Hệ thống cửa hàng cung cấp thiết bị công nghệ hàng đầu Việt Nam.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Liên kết</h5>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-white-50 text-decoration-none">Chính sách bảo hành</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Hướng dẫn thanh toán</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold">Liên hệ</h5>
                    <p class="small text-white-50">Hotline: 1800 0000<br>Email: cskh@techstore.com</p>
                </div>
            </div>
            <hr class="bg-white">
            <div class="text-center small text-white-50">
                &copy; 2026 - TechStore - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white-50">Privacy</a>
            </div>
        </div>
    </footer>

    <!-- Cart Modal -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" id="cartModalContent">
                <!-- Cart content will be loaded here via AJAX -->
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function openCartModal(e) {
            if(e) e.preventDefault();
            fetch('/Cart/Index')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('cartModalContent').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('cartModal')).show();
                });
        }

        function addToCart(productId) {
            const formData = new FormData();
            formData.append('productId', productId);

            fetch('/Cart/AddToCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
                var cartModal = bootstrap.Modal.getInstance(document.getElementById('cartModal'));
                if (!cartModal) {
                    cartModal = new bootstrap.Modal(document.getElementById('cartModal'));
                }
                cartModal.show();
            });
        }

        function updateCartQuantity(productId, quantity) {
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('quantity', quantity);

            fetch('/Cart/UpdateCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
            });
        }

        function removeFromCart(productId) {
            const formData = new FormData();
            formData.append('productId', productId);

            fetch('/Cart/RemoveFromCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
            });
        }

        function toggleItemSelection(checkbox) {
            const productId = checkbox.value;
            const isSelected = checkbox.checked;
            
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('isSelected', isSelected);

            fetch('/Cart/ToggleItemSelection', {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
            });
        }

        (function () {
            const input = document.getElementById('headerSearchInput');
            const suggest = document.getElementById('headerSearchSuggest');
            if (!input || !suggest) return;

            let timer = null;
            let lastQ = '';

            function hideSuggest() {
                suggest.style.display = 'none';
                suggest.innerHTML = '';
            }

            function showSuggest(html) {
                suggest.innerHTML = html;
                suggest.style.display = html ? 'block' : 'none';
            }

            function formatPrice(v) {
                try {
                    return Number(v).toLocaleString('vi-VN') + '₫';
                } catch {
                    return v + '₫';
                }
            }

            async function fetchSuggest(q) {
                const resp = await fetch('/Product/Suggest?q=' + encodeURIComponent(q), { method: 'GET' });
                if (!resp.ok) return [];
                return await resp.json();
            }

            function render(items, q) {
                if (!items || items.length === 0) {
                    return `
                        <div class="search-suggest-item">
                            <div class="search-suggest-sub">Không tìm thấy gợi ý cho "${q}"</div>
                        </div>
                    `;
                }

                const rows = items.map(p => {
                    const img = p.imageUrl && p.imageUrl.length ? p.imageUrl : '/lib/img/no-image.png';
                    const stockLabel = p.stockQuantity <= 0 ? '<div class="search-suggest-sub text-danger">Hết hàng</div>' : '';
                    return `
                        <a class="search-suggest-item" href="/Product/Details/${p.id}">
                            <img class="search-suggest-thumb" src="${img}" alt="">
                            <div class="flex-grow-1">
                                <div class="search-suggest-name">${p.name}</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="search-suggest-sub text-danger fw-bold">${formatPrice(p.price)}</div>
                                    ${stockLabel}
                                </div>
                            </div>
                        </a>
                    `;
                }).join('');

                const more = `
                    <a class="search-suggest-item" href="/Product/List?q=${encodeURIComponent(q)}">
                        <div class="search-suggest-sub">Xem tất cả kết quả</div>
                    </a>
                `;

                return rows + more;
            }

            input.addEventListener('input', () => {
                const q = (input.value || '').trim();
                if (q.length < 2) {
                    lastQ = q;
                    hideSuggest();
                    return;
                }

                if (timer) clearTimeout(timer);
                timer = setTimeout(async () => {
                    lastQ = q;
                    const items = await fetchSuggest(q);
                    if (lastQ !== q) return;
                    showSuggest(render(items, q));
                }, 250);
            });

            input.addEventListener('focus', () => {
                const q = (input.value || '').trim();
                if (q.length >= 2 && suggest.innerHTML) {
                    suggest.style.display = 'block';
                }
            });

            document.addEventListener('click', (e) => {
                if (!suggest.contains(e.target) && e.target !== input) {
                    hideSuggest();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    hideSuggest();
                    input.blur();
                }
            });
        })();
    </script>
    @if (!User.IsInRole("Admin"))
    {
        <!-- Floating Chat Widget Styles -->
        <style>
            .support-chat-wrapper {
                position: fixed;
                bottom: 20px;
                right: 20px;
                z-index: 1050;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            }
            .support-chat-btn {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: linear-gradient(135deg, #008BFF 0%, #0056b3 100%);
                border: none;
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                box-shadow: 0 4px 15px rgba(0, 139, 255, 0.4);
                cursor: pointer;
            }
            .support-chat-btn:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 20px rgba(0, 139, 255, 0.6);
            }
            .support-chat-container {
                display: none;
                width: 360px;
                height: 500px;
                max-height: calc(100vh - 120px);
                border-radius: 16px;
                overflow: hidden;
                flex-direction: column;
                position: absolute;
                bottom: 80px;
                right: 0;
                background: #fff;
                box-shadow: 0 12px 28px rgba(0,0,0,0.12), 0 8px 10px rgba(0,0,0,0.08);
                transition: all 0.3s ease;
            }
            .support-chat-msg {
                max-width: 80%;
                margin-bottom: 12px;
                padding: 10px 14px;
                border-radius: 16px;
                font-size: 13.5px;
                line-height: 1.4;
                word-break: break-word;
                box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            }
            .support-chat-msg.customer {
                background: linear-gradient(135deg, #008BFF 0%, #0070cc 100%);
                color: white;
                align-self: flex-end;
                border-bottom-right-radius: 2px;
            }
            .support-chat-msg.admin {
                background-color: #ffffff;
                color: #212529;
                align-self: flex-start;
                border-bottom-left-radius: 2px;
                border: 1px solid #eef2f5;
            }
            .support-chat-msg-time {
                font-size: 9px;
                opacity: 0.6;
                margin-top: 4px;
                text-align: right;
            }
            .support-chat-msg.admin .support-chat-msg-time {
                color: #74808c;
            }
            .support-chat-msg.customer .support-chat-msg-time {
                color: #e6f3ff;
            }
        </style>

        <!-- Floating Chat Widget Markup -->
        <div class="support-chat-wrapper">
            <!-- Floating Chat Button -->
            <button id="chatToggleBtn" class="support-chat-btn d-flex align-items-center justify-content-center">
                <i class="fa-solid fa-comments text-white" style="font-size: 24px;"></i>
                <span id="chatBadge" class="badge bg-danger rounded-circle position-absolute" style="top: -5px; right: -5px; display: none; font-size: 11px; padding: 4px 6px; border: 2px solid white;">0</span>
            </button>

            <!-- Chat Box Container -->
            <div id="chatBoxContainer" class="support-chat-container card border-0">
                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between px-3 py-3" style="background: linear-gradient(135deg, #008BFF 0%, #0056b3 100%); color: white; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <div class="d-flex align-items-center">
                        <div class="position-relative me-2">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background-color: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-headset text-white" style="font-size: 20px;"></i>
                            </div>
                            <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 10px; height: 10px;"></span>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" style="font-size: 15px;">Hỗ Trợ Khách Hàng</h6>
                            <small style="font-size: 11px; opacity: 0.85;">Chúng tôi luôn sẵn sàng hỗ trợ bạn</small>
                        </div>
                    </div>
                    <button type="button" id="chatCloseBtn" class="btn-close btn-close-white shadow-none" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="card-body p-3 d-flex flex-column flex-grow-1" style="overflow: hidden; background-color: #f7f9fc;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Message History -->
                        <div id="chatMessagesList" class="flex-grow-1 overflow-y-auto mb-3 pe-1 d-flex flex-column" style="height: 0;">
                            <!-- Messages will be populated by JS -->
                        </div>

                        <!-- Input area -->
                        <div class="input-group" style="background: white; border-radius: 24px; padding: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); border: 1px solid #e1e8ed;">
                            <input type="text" id="chatInputMessage" class="form-control border-0 shadow-none bg-transparent" placeholder="Nhập câu hỏi của bạn..." style="font-size: 14px; padding-left: 15px;" autocomplete="off" />
                            <button class="btn btn-primary d-flex align-items-center justify-content-center" id="chatSendBtn" style="width: 36px; height: 36px; border-radius: 50%; padding: 0; background-color: #008BFF; border: none; transition: transform 0.2s ease;">
                                <i class="fa-solid fa-paper-plane text-white" style="font-size: 14px;"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Not Logged In View -->
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center px-3">
                            <div class="mb-3 text-secondary" style="width: 64px; height: 64px; border-radius: 50%; background-color: #e9ecef; display: flex; align-items: center; justify-content: center;">
                                <i class="fa-solid fa-lock text-muted" style="font-size: 28px;"></i>
                            </div>
                            <h6 class="fw-bold mb-2">Đăng Nhập Để Trò Chuyện</h6>
                            <p class="text-muted mb-4" style="font-size: 13px;">Vui lòng đăng nhập tài khoản của bạn để bắt đầu gửi câu hỏi và nhận hỗ trợ trực tiếp từ nhân viên tư vấn.</p>
                            <a href="/Account/Login?returnUrl=@Context.Request.Path" class="btn btn-primary px-4 fw-bold" style="border-radius: 20px; font-size: 14px; background: linear-gradient(135deg, #008BFF 0%, #0056b3 100%); border: none;">Đăng nhập ngay</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- SignalR and Client Side Script -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const chatToggleBtn = document.getElementById("chatToggleBtn");
                    const chatCloseBtn = document.getElementById("chatCloseBtn");
                    const chatBoxContainer = document.getElementById("chatBoxContainer");
                    const chatMessagesList = document.getElementById("chatMessagesList");
                    const chatInputMessage = document.getElementById("chatInputMessage");
                    const chatSendBtn = document.getElementById("chatSendBtn");
                    const chatBadge = document.getElementById("chatBadge");

                    const myUserId = parseInt('@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0")');
                    let connection = null;
                    let unreadCount = 0;
                    let isChatOpen = false;
                    let isHistoryLoaded = false;

                    function playNotificationSound() {
                        try {
                            const audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2357/2357-84.wav");
                            audio.volume = 0.4;
                            audio.play();
                        } catch (e) {
                            console.log("Audio play blocked by browser policy.");
                        }
                    }

                    function scrollToBottom() {
                        chatMessagesList.scrollTop = chatMessagesList.scrollHeight;
                    }

                    function formatTime(timestampStr) {
                        try {
                            const date = new Date(timestampStr);
                            const hours = String(date.getHours()).padStart(2, '0');
                            const minutes = String(date.getMinutes()).padStart(2, '0');
                            return `${hours}:${minutes}`;
                        } catch {
                            return "";
                        }
                    }

                    function appendMessage(content, isOwn, timestamp) {
                        const msgDiv = document.createElement("div");
                        msgDiv.className = `support-chat-msg ${isOwn ? 'customer' : 'admin'}`;
                        
                        const textSpan = document.createElement("div");
                        textSpan.textContent = content;
                        msgDiv.appendChild(textSpan);

                        const timeDiv = document.createElement("div");
                        timeDiv.className = "support-chat-msg-time";
                        timeDiv.textContent = formatTime(timestamp);
                        msgDiv.appendChild(timeDiv);

                        chatMessagesList.appendChild(msgDiv);
                        scrollToBottom();
                    }

                    function loadChatHistory() {
                        fetch("/Chat/GetHistory")
                            .then(res => res.json())
                            .then(messages => {
                                chatMessagesList.innerHTML = "";
                                messages.forEach(msg => {
                                    appendMessage(msg.content, msg.isOwnMessage, msg.timestamp);
                                });
                                isHistoryLoaded = true;
                                scrollToBottom();
                                markMessagesAsRead();
                            })
                            .catch(err => console.error("Error loading chat history:", err));
                    }

                    function markMessagesAsRead() {
                        fetch("/Chat/MarkAsRead", { method: "POST" })
                            .catch(err => console.error("Error marking messages as read:", err));
                    }

                    // Open / Close chat box
                    chatToggleBtn.addEventListener("click", function () {
                        isChatOpen = !isChatOpen;
                        if (isChatOpen) {
                            chatBoxContainer.style.display = "flex";
                            chatToggleBtn.style.transform = "rotate(90deg)";
                            chatBadge.style.display = "none";
                            unreadCount = 0;
                            
                            if (!isHistoryLoaded) {
                                loadChatHistory();
                            } else {
                                scrollToBottom();
                                markMessagesAsRead();
                            }
                            setTimeout(() => chatInputMessage.focus(), 150);
                        } else {
                            closeChat();
                        }
                    });

                    chatCloseBtn.addEventListener("click", closeChat);

                    function closeChat() {
                        isChatOpen = false;
                        chatBoxContainer.style.display = "none";
                        chatToggleBtn.style.transform = "rotate(0deg)";
                    }

                    // Send message
                    function sendMessage() {
                        const content = chatInputMessage.value.trim();
                        if (!content) return;

                        if (connection && connection.state === signalR.HubConnectionState.Connected) {
                            connection.invoke("SendMessageToAdmin", content)
                                .then(() => {
                                    chatInputMessage.value = "";
                                    chatInputMessage.focus();
                                })
                                .catch(err => console.error("Error sending message via SignalR:", err));
                        }
                    }

                    chatSendBtn.addEventListener("click", sendMessage);
                    chatInputMessage.addEventListener("keypress", function (e) {
                        if (e.key === "Enter") {
                            sendMessage();
                        }
                    });

                    // Start SignalR Connection
                    connection = new signalR.HubConnectionBuilder()
                        .withUrl("/chatHub")
                        .withAutomaticReconnect()
                        .build();

                    connection.on("ReceiveMessage", function (senderId, senderName, content, timestamp, id) {
                        const isOwn = (senderId === myUserId);
                        
                        // Nếu chat đang mở, nạp tin nhắn và đánh dấu đã đọc
                        if (isChatOpen) {
                            appendMessage(content, isOwn, timestamp);
                            if (!isOwn) {
                                markMessagesAsRead();
                                playNotificationSound();
                            }
                        } else {
                            // Nếu chat đóng, tăng số lượng chưa đọc ở badge và phát âm báo
                            if (!isOwn) {
                                unreadCount++;
                                chatBadge.textContent = unreadCount;
                                chatBadge.style.display = "block";
                                playNotificationSound();
                                // Nạp tin nhắn vào DOM trước để khi mở lên là có sẵn
                                if (isHistoryLoaded) {
                                    appendMessage(content, isOwn, timestamp);
                                }
                            } else {
                                // Gửi từ thiết bị khác của chính khách hàng này
                                if (isHistoryLoaded) {
                                    appendMessage(content, isOwn, timestamp);
                                }
                            }
                        }
                    });

                    connection.start()
                        .then(() => console.log("Connected to ChatHub successfully."))
                        .catch(err => console.error("Error starting ChatHub connection:", err));
                });
            </script>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
